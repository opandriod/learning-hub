VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Local development:
# VITE_API_BASE_URL=http://localhost:5000/api

# Production on Vercel must point to your Render backend:
VITE_API_BASE_URL=https://learning-hub-backend.onrender.com/api

# Razorpay public Test Mode key ID only. Never put Razorpay secret in Vercel.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Optional demo helper button. Backend must also enable ENABLE_TEST_PAYMENT_SIMULATOR=true.
VITE_ENABLE_TEST_PAYMENT_SIMULATOR=false
