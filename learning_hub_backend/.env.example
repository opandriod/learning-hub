DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_PORT=5432
SECRET_KEY=change_this_to_a_long_random_secret
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY_OR_VALID_SERVICE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
FRONTEND_URL=http://localhost:5173
FLASK_DEBUG=0

# Manual UPI payment settings for paid project ZIPs
LEARNING_HUB_UPI_ID=yourupi@bank
LEARNING_HUB_UPI_PAYEE=Only-Learning Hub
PROJECT_UPLOADER_SHARE_PERCENT=70
PROJECT_INSTRUCTOR_SHARE_PERCENT=10
SUB_ADMIN_MAX_ZIP_MB=50
ADMIN_MAX_ZIP_MB=200

# Gemini AI Chatbox
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

DB_MINCONN=1
DB_MAXCONN=8
DB_CONNECT_TIMEOUT=5

# Razorpay Test Mode keys for Project Store
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
# Use true only during project demo/testing; keep false for real launch.
ENABLE_TEST_PAYMENT_SIMULATOR=false
